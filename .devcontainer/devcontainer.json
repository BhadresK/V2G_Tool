{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python setup_env.py && touch ~/.hushlogin",
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openBrowser"
    }
  },
  "forwardPorts": [
    8501
  ]
}